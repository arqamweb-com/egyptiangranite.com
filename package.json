{
  "name": "granite-gateway-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS v4 build pipeline for the Granite Gateway WordPress theme.",
  "scripts": {
    "css:build": "tailwindcss -i ./src/input.css -o ./assets/css/styles.css --minify",
    "css:watch": "tailwindcss -i ./src/input.css -o ./assets/css/styles.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.13",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0"
  }
}
